# Browser-visible provider key; restrict domains in provider settings.
VITE_CARTO_API_KEY=

# Server-only AIS settings (never prefix these with VITE_).
AISSTREAM_API_KEY=
AIS_BACKEND_URL=https://oil-atlas-ais.onrender.com
AIS_STREAM_STALE_MS=60000
PORT=8787

# Optional, used ONLY by explicit data:update commands.
# OIL_ATLAS_SOURCE=/path/to/geojson
# PYTHON=/path/to/python
