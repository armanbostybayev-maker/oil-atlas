{
  "name": "oil-stat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "preprocess": "node data/preprocess.mjs",
    "data:update": "node data/update.mjs",
    "ais": "node server/ais-collector.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "data:oilfields": "node scripts/python.mjs scripts/import_oilfields.py && node scripts/classify-oilfields.mjs",
    "test:oilfield-import": "node scripts/python.mjs -m unittest discover -s tests -p test_oilfield_import.py",
    "test:oilfields": "node tests/oilfields-browser.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:reliability": "node tests/reliability-browser.mjs",
    "test:vessel-types": "node tests/vessel-types-browser.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.9.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.11.0",
    "vite": "^7.1.5"
  }
}
